{
  "name": "Alveare",
  "short_name": "Alveare",
  "description": "Aplicativo para acesso ao sistema interno FloreSer da Clínica Corpo e Alma.",
  "lang": "pt-BR",
  "dir": "ltr",

  "id": "/floreser/",
  "start_url": "./",
  "scope": "./",

  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",

  "background_color": "#F5F0EB",
  "theme_color": "#3B6E6A",

  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "shortcuts": [
    {
      "name": "CRM",
      "short_name": "CRM",
      "description": "Leads, funil comercial e follow-ups",
      "url": "./crm/",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Agendamentos",
      "short_name": "Agenda",
      "description": "Retornos, ciclos e máquinas temporárias",
      "url": "./agenda/",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Entradas",
      "short_name": "Entradas",
      "description": "Entradas por dia, formas de pagamento e exportação",
      "url": "./entradas/",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
